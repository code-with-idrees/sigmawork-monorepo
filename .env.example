# ── Database ──────────────────────────────────────────────
DATABASE_URL=mysql+aiomysql://root:yourpassword@localhost:3306/sigmawork

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OAuth — Google ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# ── OAuth — GitHub ────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback

# ── App ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8000
APP_ENV=development
